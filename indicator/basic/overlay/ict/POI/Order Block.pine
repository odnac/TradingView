//@version=6
indicator('OB [odnac]', overlay = true, max_boxes_count = 500)

// ============================================================================
// INPUT PARAMETERS
// ============================================================================
show_ob         = input.bool(true, 'Show Order Blocks (Opposite Color)', group = 'Display')
max_bars_extend = input.int(100, 'Maximum Bars to Extend', minval = 10, maxval = 500, group = 'Conditions')

// Color settings
color_bull = color.new(#089981, 80) // Green
color_bear = color.new(#f23645, 80) // Red

// ============================================================================
// VARIABLES
// ============================================================================
var array<box> ob_boxes      = array.new_box()
var array<int> ob_start_bars = array.new_int()

// ============================================================================
// FUNCTIONS
// ============================================================================
check_ob_condition() =>
    float gap_top    = 0.0
    float gap_bottom = 0.0
    bool is_bull_fvg = false
    bool is_bear_fvg = false

    // Check direction of candle 1 (index 2) and candle 3 (index 0)
    bool candle1_bull = close[2] > open[2]
    bool candle3_bull = close > open
    bool same_color   = candle1_bull == candle3_bull  // OB requires opposite-color candles

    if high[2] < low
        gap_top    := low
        gap_bottom := high[2]
        is_bull_fvg := true

    else if low[2] > high
        gap_top    := low[2]
        gap_bottom := high
        is_bear_fvg := true

    [is_bull_fvg or is_bear_fvg, is_bull_fvg, same_color]

box_touched(box_top, box_bottom) =>
    not(low > box_top or high < box_bottom)

// ============================================================================
// MAIN LOGIC (Box update and removal)
// ============================================================================
if array.size(ob_boxes) > 0
    for i = array.size(ob_boxes) - 1 to 0 by 1
        b         = array.get(ob_boxes, i)
        start_bar = array.get(ob_start_bars, i)

        if not na(b)
            box_top    = box.get_top(b)
            box_bottom = box.get_bottom(b)
            box_right  = box.get_right(b)

            // Remove if expired or touched
            if (bar_index - start_bar) >= max_bars_extend or (box_right == bar_index and box_touched(box_top, box_bottom))
                array.remove(ob_boxes, i)
                array.remove(ob_start_bars, i)
            else if box_right == bar_index
                box.set_right(b, bar_index + 1)

// ============================================================================
// OB CREATION LOGIC (opposite-color candles only)
// ============================================================================
[is_fvg, is_bull, same_color] = check_ob_condition()

if is_fvg and not same_color and show_ob
    box_color = is_bull ? color_bull : color_bear
    // Draw full body of candle 1 (high to low)
    b = box.new(bar_index[2], high[2], bar_index + 1, low[2],
         border_color = color.new(box_color, 100),
         bgcolor      = box_color,
         border_width = 0)
    array.push(ob_boxes, b)
    array.push(ob_start_bars, bar_index)