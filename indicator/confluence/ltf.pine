//@version=6
indicator("LTF", overlay = true)

// ============================================================================
// DIVIDERS
// ============================================================================
showWeeklyDiver = input.bool(true, 'Show Weekly Divider', group = 'Dividers')
showDailyDiver = input.bool(true, 'Show Daily Divider', group = 'Dividers')
showh1 = input.bool(false, 'Show H1 on Daily Divider', group = 'Dividers')

showWeeklyTimeframe = timeframe.isintraday and timeframe.multiplier >= 1 and timeframe.multiplier <= 240
showDailyTimeframeFalse = timeframe.isintraday and timeframe.multiplier >= 1 and timeframe.multiplier < 60
showDailyTimeframeTrue = timeframe.isintraday and timeframe.multiplier >= 1 and timeframe.multiplier <= 60
showDailyTimeframe = showh1 ? showDailyTimeframeTrue : showDailyTimeframeFalse

is_new_week = dayofweek == dayofweek.sunday and dayofweek[1] != dayofweek.sunday
is_new_day  = dayofmonth != dayofmonth[1]

if showWeeklyDiver and is_new_week and showWeeklyTimeframe
    line.new(bar_index, close + syminfo.mintick, bar_index, close - syminfo.mintick, color = color.rgb(255, 255, 255, 70), extend = extend.both, style = line.style_dashed)

if showDailyDiver and is_new_day and showDailyTimeframe
    line.new(bar_index, close + syminfo.mintick, bar_index, close - syminfo.mintick, color = color.rgb(255, 255, 255, 85), extend = extend.both, style = line.style_dashed)


// ============================================================================
// SESSION BOXES
// ============================================================================
grp_sessions = 'Session Boxes'
showAsia   = input.bool(true, 'Show Asia Session', group=grp_sessions)
showLondon = input.bool(true, 'Show London Session', group=grp_sessions)
showNY     = input.bool(true, 'Show NY Session', group=grp_sessions)
showStatus = input.bool(true, 'Show DST Status Table', group=grp_sessions)

showSessionsInTimeframe = timeframe.isintraday and timeframe.multiplier <= 60

colorAsia   = color.new(#F48FB1, 90)
colorLondon = color.new(#FFF59D, 90)
colorNY     = color.new(#90CAF9, 90)

is_summer_time() =>
    m = month(time, 'GMT-4')
    d = dayofmonth(time, 'GMT-4')
    w = dayofweek(time, 'GMT-4')
    isAfterMarchSt = m > 3 or (m == 3 and (d - w >= 8))
    isBeforeNovSt  = m < 11 or (m == 11 and (d - w < 1))
    isAfterMarchSt and isBeforeNovSt

autoSummer = is_summer_time()

asiaTime   = '0900-1300'
londonTime = autoSummer ? '1500-1800' : '1600-1900'
nyTime     = autoSummer ? '2100-0000' : '2200-0100'

process_session(sessionTime, sessionColor, showToggle) =>
    var box sBox = na
    t = time(timeframe.period, sessionTime, 'GMT+9')
    is_new_session = not na(t) and na(t[1])
    is_in_session  = not na(t)

    if showToggle and showSessionsInTimeframe
        if is_new_session
            sBox := box.new(left = bar_index, top = high, right = bar_index, bottom = low, 
                 border_color = color.new(sessionColor, 100), bgcolor = sessionColor)
        
        if is_in_session and not na(sBox)
            box.set_right(sBox, bar_index + 1)
            box.set_top(sBox, math.max(box.get_top(sBox), high))
            box.set_bottom(sBox, math.min(box.get_bottom(sBox), low))

process_session(asiaTime, colorAsia, showAsia)
process_session(londonTime, colorLondon, showLondon)
process_session(nyTime, colorNY, showNY)

if showStatus and barstate.islast
    var table statusTable = table.new(position.top_right, 1, 1)
    table.cell(statusTable, 0, 0, autoSummer ? 'DST Active (Summer)' : 'DST Inactive (Winter)', 
         bgcolor = color.new(color.gray, 50), text_color = color.white, text_size = size.small)


// ============================================================================
// Market Structure
// ============================================================================

// INPUT SETTINGS
versionSelect = input.string('V2', 'Version', options = ['V1', 'V2'], 
     tooltip = 'V1: Use only pivot-detected swings | V2: Auto-update swing points between breaks')
leftBars      = input.int(36, 'Swing Left Bars', minval = 1, 
     tooltip = 'Number of bars to the left to detect a pivot')
rightBars     = input.int(7,  'Swing Right Bars', minval = 1, 
     tooltip = 'Number of bars to the right to confirm a pivot')
showSwings    = input.bool(true, 'Show Swing Points', 
     tooltip = 'Toggle visibility of Swing High/Low circles')
showLines     = input.bool(true, 'Show BOS/CHoCH', 
     tooltip = 'Toggle visibility of structure break lines and labels')
showTrendMode = input.string('None', 'Trend Visualization', 
     options = ['Background', 'Shape', 'None'], 
     tooltip = 'Choose how to visualize the current market trend')

// PIVOT CONFIRMATION LOGIC (Renewal based on previous candle of same type)
confirmBearish() =>
    float lastBearClose = na
    int renewCount = 0
    // Process from the bar immediately after pivot to the most recent bar
    for i = 0 to rightBars - 1
        int j = rightBars - 1 - i
        if close[j] < open[j]
            if na(lastBearClose)
                renewCount := 1
                lastBearClose := close[j]
            else if close[j] < lastBearClose
                renewCount += 1
                lastBearClose := close[j]
    
    int consecutiveBears = 0
    int maxConsecutive = 0
    for i = 1 to rightBars
        if close[i] < open[i]
            consecutiveBears += 1
            maxConsecutive := math.max(maxConsecutive, consecutiveBears)
        else
            consecutiveBears := 0
    
    renewCount >= 3 or maxConsecutive >= 3

confirmBullish() =>
    float lastBullClose = na
    int renewCount = 0
    for i = 0 to rightBars - 1
        int j = rightBars - 1 - i
        if close[j] > open[j]
            if na(lastBullClose)
                renewCount := 1
                lastBullClose := close[j]
            else if close[j] > lastBullClose
                renewCount += 1
                lastBullClose := close[j]
    
    int consecutiveBulls = 0
    int maxConsecutive = 0
    for i = 1 to rightBars
        if close[i] > open[i]
            consecutiveBulls += 1
            maxConsecutive := math.max(maxConsecutive, consecutiveBulls)
        else
            consecutiveBulls := 0
    
    renewCount >= 3 or maxConsecutive >= 3

confirmBearishV2() => confirmBearish()
confirmBullishV2() => confirmBullish()

// Detect pivot highs and lows
ph = ta.pivothigh(high, leftBars, rightBars)
pl = ta.pivotlow(low, leftBars, rightBars)

// VARIABLE MANAGEMENT & TREND DETERMINATION
var float lastHighPrice = na
var int   lastHighIndex = na
var float lastLowPrice  = na
var int   lastLowIndex  = na
var int   trend         = 0   // 1 = Bullish, -1 = Bearish, 0 = Neutral

bool isValidHigh = versionSelect == 'V1' ? (not na(ph) and confirmBearish()) : (not na(ph) and confirmBearishV2())
bool isValidLow  = versionSelect == 'V1' ? (not na(pl) and confirmBullish()) : (not na(pl) and confirmBullishV2())

if isValidHigh
    lastHighPrice := ph
    lastHighIndex := bar_index - rightBars

if isValidLow
    lastLowPrice := pl
    lastLowIndex := bar_index - rightBars

// STRUCTURE BREAK DETECTION (BOS / CHOCH)
colWhite = color.white

if versionSelect == 'V1'
    if not na(lastHighPrice) and ta.crossover(close, lastHighPrice)
        string label_text = (trend == -1 or trend == 0) ? 'CHoCH' : 'BOS'
        trend := 1
        if showLines
            line.new(lastHighIndex, lastHighPrice, bar_index, lastHighPrice, color = color.new(colWhite, 50), width = 1)
            int midX = int(math.avg(lastHighIndex, bar_index))
            label.new(midX, lastHighPrice, text = label_text, style = label.style_label_down, color = color.new(colWhite, 100), textcolor = colWhite, size = size.tiny)
        lastHighPrice := na

    else if not na(lastLowPrice) and ta.crossunder(close, lastLowPrice)
        string label_text = (trend == 1 or trend == 0) ? 'CHoCH' : 'BOS'
        trend := -1
        if showLines
            line.new(lastLowIndex, lastLowPrice, bar_index, lastLowPrice, color = color.new(colWhite, 50), width = 1)
            int midX = int(math.avg(lastLowIndex, bar_index))
            label.new(midX, lastLowPrice, text = label_text, style = label.style_label_up, color = color.new(colWhite, 100), textcolor = colWhite, size = size.tiny)
        lastLowPrice := na

else if versionSelect == 'V2'
    if not na(lastHighPrice) and ta.crossover(close, lastHighPrice)
        string label_text = (trend == -1 or trend == 0) ? 'CHoCH' : 'BOS'
        trend := 1
        
        float minLow = low
        int minIdx = bar_index
        for i = 0 to (bar_index - lastHighIndex - 1)
            if low[i] < minLow
                minLow := low[i]
                minIdx := bar_index[i]
        
        lastLowPrice := minLow
        lastLowIndex := minIdx
        
        if showLines
            line.new(lastHighIndex, lastHighPrice, bar_index, lastHighPrice, color = color.new(colWhite, 50), width = 1)
            int midX = int(math.avg(lastHighIndex, bar_index))
            label.new(midX, lastHighPrice, text = label_text, color = color.new(colWhite, 100), textcolor = colWhite, size = size.tiny, style = label.style_label_down)
        
        lastHighPrice := na

    else if not na(lastLowPrice) and ta.crossunder(close, lastLowPrice)
        string label_text = (trend == 1 or trend == 0) ? 'CHoCH' : 'BOS'
        trend := -1
        
        float maxHigh = high
        int maxIdx = bar_index
        for i = 0 to (bar_index - lastLowIndex - 1)
            if high[i] > maxHigh
                maxHigh := high[i]
                maxIdx := bar_index[i]
        
        lastHighPrice := maxHigh
        lastHighIndex := maxIdx

        if showLines
            line.new(lastLowIndex, lastLowPrice, bar_index, lastLowPrice, color = color.new(colWhite, 50), width = 1)
            int midX = int(math.avg(lastLowIndex, bar_index))
            label.new(midX, lastLowPrice, text = label_text, color = color.new(colWhite, 100), textcolor = colWhite, size = size.tiny, style = label.style_label_up)
        
        lastLowPrice := na

// VISUALIZATION
// plot(showSwings and isValidHigh ? ph : na, 'Swing High', color = color.new(colWhite, 70), style = plot.style_circles, linewidth = 4, offset = -rightBars)
// plot(showSwings and isValidLow ? pl : na, 'Swing Low', color = color.new(colWhite, 70), style = plot.style_circles, linewidth = 4, offset = -rightBars)
if showSwings and isValidHigh
    label.new(
        x         = bar_index - rightBars,
        y         = ph,
        text      = "◈",
        xloc      = xloc.bar_index,
        yloc      = yloc.abovebar,
        style     = label.style_label_down,
        color     = color(na),                
        textcolor = color.new(colWhite, 50),    
        size      = size.tiny,                  
        tooltip   = "Swing High"
    )

if showSwings and isValidLow
    label.new(
        x         = bar_index - rightBars,
        y         = pl,
        text      = "◈",
        xloc      = xloc.bar_index,
        yloc      = yloc.belowbar,
        style     = label.style_label_up,
        color     = color(na),
        textcolor = color.new(colWhite, 50),
        size      = size.tiny,
        tooltip   = "Swing Low"
    )

trendColor = trend == 1 ? color.new(color.green, 90) : trend == -1 ? color.new(color.red, 90) : na

bgcolor(showTrendMode == 'Background' ? trendColor : na, title = 'Trend Background')

plotshape(showTrendMode == 'Shape' and trend == 1, title = "Bullish Trend Shape", location = location.bottom, color = trendColor, style = shape.square, size = size.tiny)
plotshape(showTrendMode == 'Shape' and trend == -1, title = "Bearish Trend Shape", location = location.bottom, color = trendColor, style = shape.square, size = size.tiny)