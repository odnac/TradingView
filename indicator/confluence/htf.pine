//@version=6
indicator("HTF [odnac]", overlay = true)

// ============================================================================
// DIVIDERS
// ============================================================================
showWeeklyDiver = input.bool(true, 'Show Weekly Divider', group = 'Dividers')
showDailyDiver = input.bool(true, 'Show Daily Divider', group = 'Dividers')
showh1 = input.bool(false, 'Show H1 on Daily Divider', group = 'Dividers')

showWeeklyTimeframe = timeframe.isintraday and timeframe.multiplier >= 1 and timeframe.multiplier <= 240
showDailyTimeframeFalse = timeframe.isintraday and timeframe.multiplier >= 1 and timeframe.multiplier < 60
showDailyTimeframeTrue = timeframe.isintraday and timeframe.multiplier >= 1 and timeframe.multiplier <= 60
showDailyTimeframe = showh1 ? showDailyTimeframeTrue : showDailyTimeframeFalse

is_new_week = dayofweek == dayofweek.sunday and dayofweek[1] != dayofweek.sunday
is_new_day  = dayofmonth != dayofmonth[1]

if showWeeklyDiver and is_new_week and showWeeklyTimeframe
    line.new(bar_index, close + syminfo.mintick, bar_index, close - syminfo.mintick, color = color.rgb(255, 255, 255, 70), extend = extend.both, style = line.style_dashed)

if showDailyDiver and is_new_day and showDailyTimeframe
    line.new(bar_index, close + syminfo.mintick, bar_index, close - syminfo.mintick, color = color.rgb(255, 255, 255, 85), extend = extend.both, style = line.style_dashed)


// ============================================================================
// SESSION BOXES
// ============================================================================
grp_sessions = 'Session Boxes'
showAsia   = input.bool(true, 'Show Asia Session', group=grp_sessions)
showLondon = input.bool(true, 'Show London Session', group=grp_sessions)
showNY     = input.bool(true, 'Show NY Session', group=grp_sessions)
showStatus = input.bool(true, 'Show DST Status Table', group=grp_sessions)

showSessionsInTimeframe = timeframe.isintraday and timeframe.multiplier <= 60

colorAsia   = color.new(#F48FB1, 90)
colorLondon = color.new(#FFF59D, 90)
colorNY     = color.new(#90CAF9, 90)

is_summer_time() =>
    m = month(time, 'GMT-4')
    d = dayofmonth(time, 'GMT-4')
    w = dayofweek(time, 'GMT-4')
    isAfterMarchSt = m > 3 or (m == 3 and (d - w >= 8))
    isBeforeNovSt  = m < 11 or (m == 11 and (d - w < 1))
    isAfterMarchSt and isBeforeNovSt

autoSummer = is_summer_time()

asiaTime   = '0900-1300'
londonTime = autoSummer ? '1500-1800' : '1600-1900'
nyTime     = autoSummer ? '2100-0000' : '2200-0100'

process_session(sessionTime, sessionColor, showToggle) =>
    var box sBox = na
    t = time(timeframe.period, sessionTime, 'GMT+9')
    is_new_session = not na(t) and na(t[1])
    is_in_session  = not na(t)

    if showToggle and showSessionsInTimeframe
        if is_new_session
            sBox := box.new(left = bar_index, top = high, right = bar_index, bottom = low, 
                 border_color = color.new(sessionColor, 100), bgcolor = sessionColor)
        
        if is_in_session and not na(sBox)
            box.set_right(sBox, bar_index + 1)
            box.set_top(sBox, math.max(box.get_top(sBox), high))
            box.set_bottom(sBox, math.min(box.get_bottom(sBox), low))

process_session(asiaTime, colorAsia, showAsia)
process_session(londonTime, colorLondon, showLondon)
process_session(nyTime, colorNY, showNY)

if showStatus and barstate.islast
    var table statusTable = table.new(position.top_right, 1, 1)
    table.cell(statusTable, 0, 0, autoSummer ? 'DST Active (Summer)' : 'DST Inactive (Winter)', 
         bgcolor = color.new(color.gray, 50), text_color = color.white, text_size = size.small)


// ============================================================================
// HTF CANDLE
// ============================================================================

type Candle
    float o
    float c
    float h
    float l
    box body
    line wick_up
    line wick_down

type CandleGroup
    array<Candle> candles
    string htf
    int max_candles

// Input Settings
// HTF Settings
bool show_htf = input.bool(true, 'Show HTF Candles', inline = 'htf', group = 'htf')
string htf_period = input.timeframe('1D', '', inline = 'htf', group = 'htf')
int max_candles = input.int(3, '', inline = 'htf', group = 'htf')

// Custom Daily Settings
bool use_custom_daily = input.bool(false, 'Custom daily candle open', inline='custom')
string custom_daily_time = input.string('Midnight', '', options=['Midnight', '8:30', '9:30'], inline='custom')

// Colors
color bull_body_color = input.color(color.new(#089981, 0), 'Body', inline = 'body', group='htf')
color bear_body_color = input.color(color.new(#f23645, 0), '', inline = 'body', group='htf')
color bull_border_color = input.color(color.new(#089981, 0), 'Borders', inline = 'border', group='htf')
color bear_border_color = input.color(color.new(#f23645, 0), '', inline = 'border', group='htf')
color bull_wick_color = input.color(color.new(#089981, 0), 'Wick', inline = 'wick', group='htf')
color bear_wick_color = input.color(color.new(#f23645, 0), '', inline = 'wick', group='htf')

// Spacing
int chart_offset = input.int(25, 'Padding from current candles', minval = 1, group='htf')
int candle_spacing = input.int(1, 'Space between candles', minval = 1, maxval = 4, group='htf')
int candle_width = input.int(1, 'Candle Width', minval = 1, maxval = 4, group='htf') * 2

// Variables & Helper
var array<Candle> candles = array.new<Candle>(0)
var CandleGroup group = CandleGroup.new(candles, htf_period, max_candles)

isValidTimeframe(string tf) =>
    current_sec = timeframe.in_seconds()
    htf_sec = timeframe.in_seconds(tf)
    htf_sec > current_sec

// Logic Functions
reorderCandles(CandleGroup cg, int offset) =>
    size = array.size(cg.candles)
    if size > 0
        for i = size - 1 to 0
            candle = array.get(cg.candles, i)
            buffer = offset + (candle_width + candle_spacing) * (size - i - 1)
            
            box.set_left(candle.body, bar_index + buffer)
            box.set_right(candle.body, bar_index + candle_width + buffer)
            line.set_x1(candle.wick_up, bar_index + candle_width / 2 + buffer)
            line.set_x2(candle.wick_up, bar_index + candle_width / 2 + buffer)
            line.set_x1(candle.wick_down, bar_index + candle_width / 2 + buffer)
            line.set_x2(candle.wick_down, bar_index + candle_width / 2 + buffer)

monitorNewCandle(CandleGroup cg) =>

    is_new_candle = ta.change(time(cg.htf)) > 0
    
    if use_custom_daily and cg.htf == '1D'
        if custom_daily_time == 'Midnight'
            is_new_candle := dayofweek != dayofweek[1]
        else if custom_daily_time == '8:30'
            is_new_candle := not na(time(timeframe.period, "0830-0831")) and na(time(timeframe.period, "0830-0831")[1])
        else if custom_daily_time == '9:30'
            is_new_candle := not na(time(timeframe.period, "0930-0931")) and na(time(timeframe.period, "0930-0931")[1])
    
    if is_new_candle
        candle = Candle.new()
        candle.o := open
        candle.c := close
        candle.h := high
        candle.l := low
        
        is_bull = candle.c > candle.o
        
        candle.body := box.new(bar_index, math.max(candle.o, candle.c), bar_index + 2, math.min(candle.o, candle.c), is_bull ? bull_border_color : bear_border_color, 1, bgcolor = is_bull ? bull_body_color : bear_body_color)
        candle.wick_up := line.new(bar_index + 1, candle.h, bar_index, math.max(candle.o, candle.c), color = is_bull ? bull_wick_color : bear_wick_color)
        candle.wick_down := line.new(bar_index + 1, math.min(candle.o, candle.c), bar_index, candle.l, color = is_bull ? bull_wick_color : bear_wick_color)
        
        array.unshift(cg.candles, candle)
        if array.size(cg.candles) > cg.max_candles
            old_candle = array.pop(cg.candles)
            box.delete(old_candle.body)
            line.delete(old_candle.wick_up)
            line.delete(old_candle.wick_down)

updateCurrentCandle(CandleGroup cg, int offset) =>
    if array.size(cg.candles) > 0
        candle = array.first(cg.candles)
        candle.h := math.max(high, candle.h)
        candle.l := math.min(low, candle.l)
        candle.c := close
        
        is_bull = candle.c > candle.o
        box.set_top(candle.body, math.max(candle.o, candle.c))
        box.set_bottom(candle.body, math.min(candle.o, candle.c))
        box.set_bgcolor(candle.body, is_bull ? bull_body_color : bear_body_color)
        box.set_border_color(candle.body, is_bull ? bull_border_color : bear_border_color)
        line.set_y1(candle.wick_up, candle.h)
        line.set_y2(candle.wick_up, math.max(candle.o, candle.c))
        line.set_y1(candle.wick_down, candle.l)
        line.set_y2(candle.wick_down, math.min(candle.o, candle.c))
        line.set_color(candle.wick_up, is_bull ? bull_wick_color : bear_wick_color)
        line.set_color(candle.wick_down, is_bull ? bull_wick_color : bear_wick_color)
        
        if barstate.islast
            reorderCandles(cg, offset)

// Execution
if show_htf and isValidTimeframe(htf_period)
    monitorNewCandle(group)
    updateCurrentCandle(group, chart_offset)