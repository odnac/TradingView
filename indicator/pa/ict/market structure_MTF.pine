//@version=6
indicator('Market Structure MTF', overlay = true, max_labels_count = 500, max_lines_count = 500)

// ============================================================================
// Market Structure
// ============================================================================
versionSelect = input.string('V2', 'Version', options = ['V1', 'V2'], tooltip = 'V1: Use only pivot-detected swings | V2: Auto-update swing points between breaks', group = 'Market Structure')
leftBars = input.int(60, 'Swing Left Bars', minval = 1, tooltip = 'Number of bars to the left to detect a pivot', group = 'Market Structure')
rightBars = input.int(7, 'Swing Right Bars', minval = 1, tooltip = 'Number of bars to the right to confirm a pivot', group = 'Market Structure')
showSwings = input.bool(true, 'Show Swing Points', tooltip = 'Toggle visibility of Swing High/Low circles', group = 'Market Structure')
showLines = input.bool(true, 'Show BOS/CHoCH', tooltip = 'Toggle visibility of structure break lines and labels', group = 'Market Structure')
showTrendMode = input.string('None', 'Trend Visualization', options = ['Background', 'Shape', 'None'], tooltip = 'Choose how to visualize the current market trend', group = 'Market Structure')
enableTimeframeFilter = input.bool(true, 'Enable Timeframe Filter (15m+)', tooltip = 'When enabled, Market Structure will only show on 15-minute timeframe or higher', group = 'Market Structure')

// ============================================================================
// Multi-Timeframe Table Settings
// ============================================================================
showMTFTable = input.bool(true, 'Show MTF Trend Table', tooltip = 'Display multi-timeframe trend table in top-right corner', group = 'Multi-Timeframe')
show15m = input.bool(true, 'Show 15m Trend', group = 'Multi-Timeframe')
show1h = input.bool(true, 'Show 1H Trend', group = 'Multi-Timeframe')

showMarketStructure = enableTimeframeFilter ? timeframe.isintraday and timeframe.multiplier >= 15 or not timeframe.isintraday : true

confirmBearish() =>
    float lastBearClose = na
    int renewCount = 0
    for i = 0 to rightBars - 1 by 1
        int j = rightBars - 1 - i
        if close[j] < open[j]
            if na(lastBearClose)
                renewCount := 1
                lastBearClose := close[j]
                lastBearClose
            else if close[j] < lastBearClose
                renewCount := renewCount + 1
                lastBearClose := close[j]
                lastBearClose

    int consecutiveBears = 0
    int maxConsecutive = 0
    for i = 1 to rightBars by 1
        if close[i] < open[i]
            consecutiveBears := consecutiveBears + 1
            maxConsecutive := math.max(maxConsecutive, consecutiveBears)
            maxConsecutive
        else
            consecutiveBears := 0
            consecutiveBears

    renewCount >= 3 or maxConsecutive >= 3

confirmBullish() =>
    float lastBullClose = na
    int renewCount = 0
    for i = 0 to rightBars - 1 by 1
        int j = rightBars - 1 - i
        if close[j] > open[j]
            if na(lastBullClose)
                renewCount := 1
                lastBullClose := close[j]
                lastBullClose
            else if close[j] > lastBullClose
                renewCount := renewCount + 1
                lastBullClose := close[j]
                lastBullClose

    int consecutiveBulls = 0
    int maxConsecutive = 0
    for i = 1 to rightBars by 1
        if close[i] > open[i]
            consecutiveBulls := consecutiveBulls + 1
            maxConsecutive := math.max(maxConsecutive, consecutiveBulls)
            maxConsecutive
        else
            consecutiveBulls := 0
            consecutiveBulls

    renewCount >= 3 or maxConsecutive >= 3

confirmBearishV2() =>
    confirmBearish()
confirmBullishV2() =>
    confirmBullish()

ph = ta.pivothigh(high, leftBars, rightBars)
pl = ta.pivotlow(low, leftBars, rightBars)

var float lastHighPrice = na
var int lastHighIndex = na
var float lastLowPrice = na
var int lastLowIndex = na
var int trend = 0 // 1 = Bullish, -1 = Bearish, 0 = Neutral

bool isValidHigh = versionSelect == 'V1' ? not na(ph) and confirmBearish() : not na(ph) and confirmBearishV2()
bool isValidLow = versionSelect == 'V1' ? not na(pl) and confirmBullish() : not na(pl) and confirmBullishV2()

if isValidHigh
    lastHighPrice := ph
    lastHighIndex := bar_index - rightBars
    lastHighIndex

if isValidLow
    lastLowPrice := pl
    lastLowIndex := bar_index - rightBars
    lastLowIndex

// STRUCTURE BREAK DETECTION (BOS / CHOCH)
colWhite = color.white

if versionSelect == 'V1'
    if not na(lastHighPrice) and ta.crossover(close, lastHighPrice)
        string label_text = trend == -1 or trend == 0 ? 'CHoCH' : 'BOS'
        trend := 1
        if showLines and showMarketStructure
            line.new(lastHighIndex, lastHighPrice, bar_index, lastHighPrice, color = color.new(colWhite, 50), width = 1)
            int midX = int(math.avg(lastHighIndex, bar_index))
            label.new(midX, lastHighPrice, text = label_text, style = label.style_label_down, color = color.new(colWhite, 100), textcolor = colWhite, size = size.tiny)
        lastHighPrice := na
        lastHighPrice

    else if not na(lastLowPrice) and ta.crossunder(close, lastLowPrice)
        string label_text = trend == 1 or trend == 0 ? 'CHoCH' : 'BOS'
        trend := -1
        if showLines and showMarketStructure
            line.new(lastLowIndex, lastLowPrice, bar_index, lastLowPrice, color = color.new(colWhite, 50), width = 1)
            int midX = int(math.avg(lastLowIndex, bar_index))
            label.new(midX, lastLowPrice, text = label_text, style = label.style_label_up, color = color.new(colWhite, 100), textcolor = colWhite, size = size.tiny)
        lastLowPrice := na
        lastLowPrice

else if versionSelect == 'V2'
    if not na(lastHighPrice) and ta.crossover(close, lastHighPrice)
        string label_text = trend == -1 or trend == 0 ? 'CHoCH' : 'BOS'
        trend := 1

        float minLow = low
        int minIdx = bar_index
        for i = 0 to bar_index - lastHighIndex - 1 by 1
            if low[i] < minLow
                minLow := low[i]
                minIdx := bar_index[i]
                minIdx

        lastLowPrice := minLow
        lastLowIndex := minIdx

        if showLines and showMarketStructure
            line.new(lastHighIndex, lastHighPrice, bar_index, lastHighPrice, color = color.new(colWhite, 50), width = 1)
            int midX = int(math.avg(lastHighIndex, bar_index))
            label.new(midX, lastHighPrice, text = label_text, color = color.new(colWhite, 100), textcolor = colWhite, size = size.tiny, style = label.style_label_down)

        lastHighPrice := na
        lastHighPrice

    else if not na(lastLowPrice) and ta.crossunder(close, lastLowPrice)
        string label_text = trend == 1 or trend == 0 ? 'CHoCH' : 'BOS'
        trend := -1

        float maxHigh = high
        int maxIdx = bar_index
        for i = 0 to bar_index - lastLowIndex - 1 by 1
            if high[i] > maxHigh
                maxHigh := high[i]
                maxIdx := bar_index[i]
                maxIdx

        lastHighPrice := maxHigh
        lastHighIndex := maxIdx

        if showLines and showMarketStructure
            line.new(lastLowIndex, lastLowPrice, bar_index, lastLowPrice, color = color.new(colWhite, 50), width = 1)
            int midX = int(math.avg(lastLowIndex, bar_index))
            label.new(midX, lastLowPrice, text = label_text, color = color.new(colWhite, 100), textcolor = colWhite, size = size.tiny, style = label.style_label_up)

        lastLowPrice := na
        lastLowPrice

// VISUALIZATION
if showSwings and showMarketStructure and isValidHigh
    label.new(x = bar_index - rightBars, y = ph, text = '◈', xloc = xloc.bar_index, yloc = yloc.abovebar, style = label.style_label_down, color = color(na), textcolor = color.new(colWhite, 50), size = size.tiny, tooltip = 'Swing High')

if showSwings and showMarketStructure and isValidLow
    label.new(x = bar_index - rightBars, y = pl, text = '◈', xloc = xloc.bar_index, yloc = yloc.belowbar, style = label.style_label_up, color = color(na), textcolor = color.new(colWhite, 50), size = size.tiny, tooltip = 'Swing Low')

trendColor = trend == 1 ? color.new(color.green, 90) : trend == -1 ? color.new(color.red, 90) : na

bgcolor(showTrendMode == 'Background' and showMarketStructure ? trendColor : na, title = 'Trend Background')

plotshape(showTrendMode == 'Shape' and showMarketStructure and trend == 1, title = 'Bullish Trend Shape', location = location.bottom, color = trendColor, style = shape.square, size = size.tiny)
plotshape(showTrendMode == 'Shape' and showMarketStructure and trend == -1, title = 'Bearish Trend Shape', location = location.bottom, color = trendColor, style = shape.square, size = size.tiny)

// ============================================================================
// Multi-Timeframe Trend Analysis
// ============================================================================

trend_15m = request.security(syminfo.tickerid, '15', trend, lookahead = barmerge.lookahead_off)
trend_1h = request.security(syminfo.tickerid, '60', trend, lookahead = barmerge.lookahead_off)

bool showTable = showMTFTable and timeframe.isintraday and timeframe.multiplier <= 60

var table trendTable = table.new(position.top_right, 2, 3, border_width = 1)

if barstate.islast and showTable
    table.cell(trendTable, 0, 0, 'Timeframe', text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(trendTable, 1, 0, 'Trend', text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)

    int rowIndex = 1

    if show15m
        string trend15Text = trend_15m == 1 ? 'Bullish ↑' : trend_15m == -1 ? 'Bearish ↓' : 'Neutral —'
        color trend15Color = trend_15m == 1 ? color.new(color.green, 30) : trend_15m == -1 ? color.new(color.red, 30) : color.new(color.gray, 30)
        table.cell(trendTable, 0, rowIndex, '15m', text_color = color.white, text_size = size.normal)
        table.cell(trendTable, 1, rowIndex, trend15Text, text_color = color.white, bgcolor = trend15Color, text_size = size.normal)
        rowIndex := rowIndex + 1
        rowIndex

    if show1h
        string trend1hText = trend_1h == 1 ? 'Bullish ↑' : trend_1h == -1 ? 'Bearish ↓' : 'Neutral —'
        color trend1hColor = trend_1h == 1 ? color.new(color.green, 30) : trend_1h == -1 ? color.new(color.red, 30) : color.new(color.gray, 30)
        table.cell(trendTable, 0, rowIndex, '1H', text_color = color.white, text_size = size.normal)
        table.cell(trendTable, 1, rowIndex, trend1hText, text_color = color.white, bgcolor = trend1hColor, text_size = size.normal)
