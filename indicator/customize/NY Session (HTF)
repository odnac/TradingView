//@version=6
indicator('NY Session (HTF)', overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 5000)

displayOption = display.all - display.status_line

// ============================================================================
// INPUT SETTINGS — HTF Candle (15m Fixed for 1m Chart)
// ============================================================================
bool show_htf       = input.bool(true, 'Show HTF 15m Candles (1m Chart Only)', group = 'HTF Candle (15m)')
int  max_candles    = input.int(11, 'Max Candles to Show', minval = 1, group = 'HTF Candle (15m)')

color bull_body_color   = input.color(color.new(#089981, 0), 'Body', inline = 'body', group = 'HTF Candle (15m)')
color bear_body_color   = input.color(color.new(#f23645, 0), '', inline = 'body', group = 'HTF Candle (15m)')
color bull_border_color = input.color(color.new(#089981, 0), 'Borders', inline = 'border', group = 'HTF Candle (15m)')
color bear_border_color = input.color(color.new(#f23645, 0), '', inline = 'border', group = 'HTF Candle (15m)')
color bull_wick_color   = input.color(color.new(#089981, 0), 'Wick', inline = 'wick', group = 'HTF Candle (15m)')
color bear_wick_color   = input.color(color.new(#f23645, 0), '', inline = 'wick', group = 'HTF Candle (15m)')

int chart_offset    = input.int(20, 'Padding from current candles', minval = 1, group = 'HTF Candle (15m)', display = displayOption)
int candle_spacing  = input.int(1, 'Space between candles', minval = 1, maxval = 4, group = 'HTF Candle (15m)', display = displayOption)
int candle_width    = input.int(1, 'Candle Width', minval = 1, maxval = 4, group = 'HTF Candle (15m)', display = displayOption) * 2

bool   show_htf_timer  = input.bool(true, 'Show Remaining Time (남은 시간 표시)', group = 'HTF Candle (15m)')
color  timer_txt_color = input.color(color.white, 'Timer Text Color', group = 'HTF Candle (15m)')
string timer_size      = input.string('small', 'Timer Label Size', options = ['tiny', 'small', 'normal', 'large', 'huge'], group = 'HTF Candle (15m)', display = displayOption)

string selectedTz     = input.string('UTC-4', '표시 시간대 (Timezone)', 
                         options = ['America/New_York', 'UTC-10', 'UTC-9', 'UTC-8', 'UTC-7', 'UTC-6', 'UTC-5', 'UTC-4', 'UTC-3', 'UTC-2', 'UTC-1', 'UTC+0', 'UTC+1', 'UTC+2', 'UTC+3', 'UTC+4', 'UTC+5', 'UTC+6', 'UTC+7', 'UTC+8', 'UTC+9', 'UTC+10', 'UTC+11', 'UTC+12', 'UTC+13'], 
                         group = 'HTF Candle (15m)')
bool   show_candle_time = input.bool(true, 'Show Candle Start Time (시작 시간 표시)', group = 'HTF Candle (15m)')
color  cand_time_color  = input.color(color.gray, 'Candle Time Color', group = 'HTF Candle (15m)')
string cand_time_size  = input.string('small', 'Candle Time Size', options = ['tiny', 'small', 'normal', 'large', 'huge'], group = 'HTF Candle (15m)', display = displayOption)

bool  show_htf_fvg   = input.bool(true, 'HTF 15m FVG 표시', group = 'HTF FVG Settings')
color bull_fvg_color = input.color(color.new(#089981, 75), '상승 FVG 색상', group = 'HTF FVG Settings')
color bear_fvg_color = input.color(color.new(#f23645, 75), '하락 FVG 색상', group = 'HTF FVG Settings')


// ============================================================================
// 시간 및 세션 상태 정의
// ============================================================================
isMarketOpen  = not na(time('1', '0930-1600', 'America/New_York'))
isNineThirty  = hour(time, 'America/New_York') == 9 and minute(time, 'America/New_York') == 30
isMarketClose = isMarketOpen[1] and not isMarketOpen
bool isOneMinChart = timeframe.isintraday and timeframe.multiplier == 1


// ============================================================================
// HTF Candle (15m) — Type Definitions & Logic
// ============================================================================
type Candle
    float o
    float c
    float h
    float l
    box   body
    line  wick_up
    line  wick_down
    label timeLabel

type FvgBox
    box   fvgBox
    int   c1_idx

type CandleGroup
    array<Candle> candles
    array<FvgBox> fvgs
    string        htf
    int           max_candles
    label         timerLabel

string htf_period = '15'

var array<Candle> candles = array.new<Candle>(0)
var array<FvgBox> fvgs    = array.new<FvgBox>(0)
var CandleGroup   group   = CandleGroup.new(candles, fvgs, htf_period, max_candles, na)

pad2(n) =>
    n < 10 ? '0' + str.tostring(n) : str.tostring(n)

f_formatRemaining(ms) =>
    total_sec = int(math.max(ms, 0) / 1000)
    mm = int(total_sec / 60)
    ss = total_sec % 60
    pad2(mm) + ':' + pad2(ss)

f_formatTime(t, tzChoice) =>
    int h = na
    int m = na
    if tzChoice == 'America/New_York'
        h := hour(t, 'America/New_York')
        m := minute(t, 'America/New_York')
    else
        offsetVal = str.tonumber(str.replace(tzChoice, 'UTC', ''))
        offsetMs  = int(offsetVal * 60 * 60 * 1000)
        adjTime   = t + offsetMs
        h := hour(adjTime, 'UTC')
        m := minute(adjTime, 'UTC')
    pad2(h) + ':' + pad2(m)

clearHtfCandles(CandleGroup cg) =>
    if array.size(cg.candles) > 0
        for i = 0 to array.size(cg.candles) - 1 by 1
            oldCandle = array.get(cg.candles, i)
            box.delete(oldCandle.body)
            line.delete(oldCandle.wick_up)
            line.delete(oldCandle.wick_down)
            label.delete(oldCandle.timeLabel)
        array.clear(cg.candles)
    if array.size(cg.fvgs) > 0
        for i = 0 to array.size(cg.fvgs) - 1 by 1
            box.delete(array.get(cg.fvgs, i).fvgBox)
        array.clear(cg.fvgs)
    label.delete(cg.timerLabel)
    cg.timerLabel := na

if isNineThirty or isMarketClose
    clearHtfCandles(group)

updateFvgs(CandleGroup cg, int offset) =>
    if array.size(cg.fvgs) > 0
        for i = 0 to array.size(cg.fvgs) - 1 by 1
            box.delete(array.get(cg.fvgs, i).fvgBox)
        array.clear(cg.fvgs)

    size = array.size(cg.candles)
    if show_htf_fvg and size >= 3
        for i = 0 to size - 3 by 1
            c0 = array.get(cg.candles, i)
            c2 = array.get(cg.candles, i + 2)

            isBullFvg = c0.l > c2.h
            isBearFvg = c0.h < c2.l

            if isBullFvg or isBearFvg
                left_buffer  = offset + (candle_width + candle_spacing) * (size - (i + 2) - 1)
                right_buffer = offset + (candle_width + candle_spacing) * (size - i) - candle_spacing

                top_val    = isBullFvg ? c0.l : c2.l
                bottom_val = isBullFvg ? c2.h : c0.h
                fvgColor   = isBullFvg ? bull_fvg_color : bear_fvg_color

                b = box.new(left = bar_index + left_buffer, top = top_val, right = bar_index + right_buffer, bottom = bottom_val, bgcolor = fvgColor, border_color = color.new(fvgColor, 100))
                array.push(cg.fvgs, FvgBox.new(b, i))

reorderCandles(CandleGroup cg, int offset) =>
    size = array.size(cg.candles)
    if size > 0
        for i = size - 1 to 0 by 1
            candle = array.get(cg.candles, i)
            buffer = offset + (candle_width + candle_spacing) * (size - i - 1)
            candleX = bar_index + candle_width / 2 + buffer

            box.set_left(candle.body, bar_index + buffer)
            box.set_right(candle.body, bar_index + candle_width + buffer)
            line.set_x1(candle.wick_up, candleX)
            line.set_x2(candle.wick_up, candleX)
            line.set_x1(candle.wick_down, candleX)
            line.set_x2(candle.wick_down, candleX)

            if not na(candle.timeLabel)
                label.set_x(candle.timeLabel, candleX)
                label.set_y(candle.timeLabel, candle.l)

        if show_htf_timer
            currentCandle = array.first(cg.candles)
            currentBuffer = offset + (candle_width + candle_spacing) * (size - 1)
            labelX = bar_index + candle_width / 2 + currentBuffer

            remain_ms = time_close(cg.htf) - (barstate.isrealtime ? timenow : time_close)
            txt = f_formatRemaining(remain_ms)

            if na(cg.timerLabel)
                cg.timerLabel := label.new(x = labelX, y = currentCandle.h, text = txt, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = color.new(color.black, 100), textcolor = timer_txt_color, size = timer_size == 'tiny' ? size.tiny : timer_size == 'small' ? size.small : timer_size == 'normal' ? size.normal : timer_size == 'large' ? size.large : size.huge)

            label.set_x(cg.timerLabel, labelX)
            label.set_y(cg.timerLabel, currentCandle.h)
            label.set_text(cg.timerLabel, txt)
            cg.timerLabel
        else
            label.delete(cg.timerLabel)
            cg.timerLabel := na

    updateFvgs(cg, offset)

monitorNewCandle(CandleGroup cg) =>
    is_new_candle = ta.change(time(cg.htf)) > 0

    if is_new_candle
        candle = Candle.new()
        candle.o := open
        candle.c := close
        candle.h := high
        candle.l := low

        is_bull = candle.c > candle.o

        candle.body      := box.new(bar_index, math.max(candle.o, candle.c), bar_index + 2, math.min(candle.o, candle.c), is_bull ? bull_border_color : bear_border_color, 1, bgcolor = is_bull ? bull_body_color : bear_body_color)
        candle.wick_up   := line.new(bar_index + 1, candle.h, bar_index, math.max(candle.o, candle.c), color = is_bull ? bull_wick_color : bear_wick_color)
        candle.wick_down := line.new(bar_index + 1, math.min(candle.o, candle.c), bar_index, candle.l, color = is_bull ? bull_wick_color : bear_wick_color)

        if show_candle_time
            timeStr = f_formatTime(time, selectedTz)
            candle.timeLabel := label.new(x = bar_index, y = candle.l, text = timeStr, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_up, color = color.new(color.black, 100), textcolor = cand_time_color, size = cand_time_size == 'tiny' ? size.tiny : cand_time_size == 'small' ? size.small : cand_time_size == 'normal' ? size.normal : cand_time_size == 'large' ? size.large : size.huge)

        array.unshift(cg.candles, candle)
        if array.size(cg.candles) > cg.max_candles
            old_candle = array.pop(cg.candles)
            box.delete(old_candle.body)
            line.delete(old_candle.wick_up)
            line.delete(old_candle.wick_down)
            label.delete(old_candle.timeLabel)

updateCurrentCandle(CandleGroup cg, int offset) =>
    if array.size(cg.candles) > 0
        candle = array.first(cg.candles)
        candle.h := math.max(high, candle.h)
        candle.l := math.min(low, candle.l)
        candle.c := close

        is_bull = candle.c > candle.o
        box.set_top(candle.body, math.max(candle.o, candle.c))
        box.set_bottom(candle.body, math.min(candle.o, candle.c))
        box.set_bgcolor(candle.body, is_bull ? bull_body_color : bear_body_color)
        box.set_border_color(candle.body, is_bull ? bull_border_color : bear_border_color)
        line.set_y1(candle.wick_up, candle.h)
        line.set_y2(candle.wick_up, math.max(candle.o, candle.c))
        line.set_y1(candle.wick_down, candle.l)
        line.set_y2(candle.wick_down, math.min(candle.o, candle.c))
        line.set_color(candle.wick_up, is_bull ? bull_wick_color : bear_wick_color)
        line.set_color(candle.wick_down, is_bull ? bull_wick_color : bear_wick_color)

        if not na(candle.timeLabel)
            label.set_y(candle.timeLabel, candle.l)

        if barstate.islast
            reorderCandles(cg, offset)

if show_htf and isOneMinChart and isMarketOpen
    monitorNewCandle(group)
    updateCurrentCandle(group, chart_offset)
