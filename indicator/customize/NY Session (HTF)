// ============================================================================
// Time and Session State Definitions
// ============================================================================
isMarketOpen  = not na(time('1', '0930-1600', 'America/New_York'))
isNineThirty  = hour(time, 'America/New_York') == 9 and minute(time, 'America/New_York') == 30
isMarketClose = isMarketOpen[1] and not isMarketOpen
bool isOneMinChart = timeframe.isintraday and timeframe.multiplier == 1

// 4-hour rolling start time: UTC 05:00 (Fixed to UTC boundary, regardless of daylight saving)
isFourHourStart = hour(time, 'UTC') == 5 and minute(time, 'UTC') == 0

var bool isFourHourWindow = false
if isFourHourStart
    isFourHourWindow := true
if isMarketClose
    isFourHourWindow := false

// ============================================================================
// HTF Candle — Type Definitions
// ============================================================================
type Candle
    float o
    float c
    float h
    float l
    box   body
    line  wick_up
    line  wick_down
    label timeLabel
    line  high_line 
    line  low_line

type FvgBox
    box   fvgBox
    int   c1_idx

type CandleGroup
    array<Candle> candles
    array<FvgBox> fvgs
    string        htf
    int           max_candles
    label         timerLabel
    color         bodyBull
    color         bodyBear
    color         borderBull
    color         borderBear
    color         wickBull
    color         wickBear
    bool          showFvg
    color         fvgBullColor
    color         fvgBearColor
    bool          showLiq
    color         liqColor
    int           liqWidth
    string        liqStyle

var array<Candle> candles15 = array.new<Candle>(0)
var array<FvgBox> fvgs15    = array.new<FvgBox>(0)
var CandleGroup   group15   = CandleGroup.new(candles15, fvgs15, '15', max_candles_15, na,
                            bull_body_color, bear_body_color, bull_border_color, bear_border_color, bull_wick_color, bear_wick_color,
                            show_htf_fvg_15, bull_fvg_color, bear_fvg_color,
                            show_htf_liq_15, liq_line_color, liq_line_width, liq_line_style)

var array<Candle> candles4h = array.new<Candle>(0)
var array<FvgBox> fvgs4h    = array.new<FvgBox>(0)
var CandleGroup   group4h   = CandleGroup.new(candles4h, fvgs4h, '240', max_candles_4h, na,
                            bull_body_color, bear_body_color, bull_border_color, bear_border_color, bull_wick_color, bear_wick_color,
                            show_htf_fvg_4h, bull_fvg_color, bear_fvg_color,
                            show_htf_liq_4h, liq_line_color, liq_line_width, liq_line_style)

f_getLineStyle(styleStr) =>
    styleStr == 'Solid' ? line.style_solid : styleStr == 'Dashed' ? line.style_dashed : line.style_dotted

pad2(n) =>
    n < 10 ? '0' + str.tostring(n) : str.tostring(n)

f_formatRemaining(ms, htfStr) =>
    total_sec = int(math.max(ms, 0) / 1000)
    hh = int(total_sec / 3600)
    mm = int((total_sec % 3600) / 60)
    ss = total_sec % 60
    htfStr == '240' ? pad2(hh) + ':' + pad2(mm) + ':' + pad2(ss) : pad2(mm) + ':' + pad2(ss)

f_formatTime(t, tzChoice) =>
    int h = na
    int m = na
    if tzChoice == 'America/New_York'
        h := hour(t, 'America/New_York')
        m := minute(t, 'America/New_York')
    else
        offsetVal = str.tonumber(str.replace(tzChoice, 'UTC', ''))
        offsetMs  = int(offsetVal * 60 * 60 * 1000)
        adjTime   = t + offsetMs
        h := hour(adjTime, 'UTC')
        m := minute(adjTime, 'UTC')
    pad2(h) + ':' + pad2(m)

clearHtfCandles(CandleGroup cg) =>
    if array.size(cg.candles) > 0
        for i = 0 to array.size(cg.candles) - 1 by 1
            oldCandle = array.get(cg.candles, i)
            box.delete(oldCandle.body)
            line.delete(oldCandle.wick_up)
            line.delete(oldCandle.wick_down)
            label.delete(oldCandle.timeLabel)
            if not na(oldCandle.high_line)
                line.delete(oldCandle.high_line)
            if not na(oldCandle.low_line)
                line.delete(oldCandle.low_line)
        array.clear(cg.candles)
    if array.size(cg.fvgs) > 0
        for i = 0 to array.size(cg.fvgs) - 1 by 1
            box.delete(array.get(cg.fvgs, i).fvgBox)
        array.clear(cg.fvgs)
    label.delete(cg.timerLabel)
    cg.timerLabel := na

// 15-min group resets at each session start/close
if isNineThirty or isMarketClose
    clearHtfCandles(group15)

// 4-hour group resets at rolling start time and clears at session close
if isFourHourStart or isMarketClose
    clearHtfCandles(group4h)

updateFvgs(CandleGroup cg, int offset) =>
    if array.size(cg.fvgs) > 0
        for i = 0 to array.size(cg.fvgs) - 1 by 1
            box.delete(array.get(cg.fvgs, i).fvgBox)
        array.clear(cg.fvgs)

    size = array.size(cg.candles)
    if cg.showFvg and size >= 3
        for i = 0 to size - 3 by 1
            c0 = array.get(cg.candles, i)
            c2 = array.get(cg.candles, i + 2)

            isBullFvg = c0.l > c2.h
            isBearFvg = c0.h < c2.l

            if isBullFvg or isBearFvg
                left_buffer  = offset + (candle_width + candle_spacing) * (size - (i + 2) - 1)
                right_buffer = offset + (candle_width + candle_spacing) * (size - i) - candle_spacing

                top_val    = isBullFvg ? c0.l : c2.l
                bottom_val = isBullFvg ? c2.h : c0.h
                fvgColor   = isBullFvg ? cg.fvgBullColor : cg.fvgBearColor

                b = box.new(left = bar_index + left_buffer, top = top_val, right = bar_index + right_buffer, bottom = bottom_val, bgcolor = fvgColor, border_color = color.new(fvgColor, 100))
                array.push(cg.fvgs, FvgBox.new(b, i))

reorderCandles(CandleGroup cg, int offset) =>
    size = array.size(cg.candles)
    if size > 0
        for i = size - 1 to 0 by 1
            candle = array.get(cg.candles, i)
            candlePrev = (i + 1 < size) ? array.get(cg.candles, i + 1) : na

            buffer = offset + (candle_width + candle_spacing) * (size - i - 1)
            candleX = bar_index + candle_width / 2 + buffer

            is_bull = candle.c > candle.o
            is_white = show_white_candle and not na(candlePrev) and ((candlePrev.h < candle.h and candlePrev.l > candle.c) or (candlePrev.l > candle.l and candlePrev.h < candle.c))

            c_body   = is_white ? white_candle_color : (is_bull ? cg.bodyBull : cg.bodyBear)
            c_border = is_white ? white_candle_color : (is_bull ? cg.borderBull : cg.borderBear)
            c_wick   = is_white ? white_candle_color : (is_bull ? cg.wickBull : cg.wickBear)

            box.set_bgcolor(candle.body, c_body)
            box.set_border_color(candle.body, c_border)
            line.set_color(candle.wick_up, c_wick)
            line.set_color(candle.wick_down, c_wick)

            box.set_left(candle.body, bar_index + buffer)
            box.set_right(candle.body, bar_index + candle_width + buffer)
            line.set_x1(candle.wick_up, candleX)
            line.set_x2(candle.wick_up, candleX)
            line.set_x1(candle.wick_down, candleX)
            line.set_x2(candle.wick_down, candleX)

            if not na(candle.timeLabel)
                label.set_x(candle.timeLabel, candleX)
                label.set_y(candle.timeLabel, candle.l)

            nextWickX = candleX + candle_width + candle_spacing

            if not na(candle.high_line)
                line.set_x1(candle.high_line, candleX)
                line.set_x2(candle.high_line, nextWickX)
                line.set_y1(candle.high_line, candle.h)
                line.set_y2(candle.high_line, candle.h)

            if not na(candle.low_line)
                line.set_x1(candle.low_line, candleX)
                line.set_x2(candle.low_line, nextWickX)
                line.set_y1(candle.low_line, candle.l)
                line.set_y2(candle.low_line, candle.l)

        if show_htf_timer
            currentCandle = array.first(cg.candles)
            currentBuffer = offset + (candle_width + candle_spacing) * (size - 1)
            labelX = bar_index + candle_width / 2 + currentBuffer

            remain_ms = time_close(cg.htf) - (barstate.isrealtime ? timenow : time_close)
            txt = f_formatRemaining(remain_ms, cg.htf)

            if na(cg.timerLabel)
                cg.timerLabel := label.new(x = labelX, y = currentCandle.h, text = txt, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = color.new(color.black, 100), textcolor = timer_txt_color, size = timer_size == 'tiny' ? size.tiny : timer_size == 'small' ? size.small : timer_size == 'normal' ? size.normal : timer_size == 'large' ? size.large : size.huge)

            label.set_x(cg.timerLabel, labelX)
            label.set_y(cg.timerLabel, currentCandle.h)
            label.set_text(cg.timerLabel, txt)
            cg.timerLabel
        else
            label.delete(cg.timerLabel)
            cg.timerLabel := na

    updateFvgs(cg, offset)

monitorNewCandle(CandleGroup cg, bool is_new_candle) =>
    if is_new_candle
        candle = Candle.new()
        candle.o := open
        candle.c := close
        candle.h := high
        candle.l := low

        is_bull = candle.c > candle.o

        candle.body      := box.new(bar_index, math.max(candle.o, candle.c), bar_index + 2, math.min(candle.o, candle.c), is_bull ? cg.borderBull : cg.borderBear, 1, bgcolor = is_bull ? cg.bodyBull : cg.bodyBear)
        candle.wick_up   := line.new(bar_index + 1, candle.h, bar_index, math.max(candle.o, candle.c), color = is_bull ? cg.wickBull : cg.wickBear)
        candle.wick_down := line.new(bar_index + 1, math.min(candle.o, candle.c), bar_index, candle.l, color = is_bull ? cg.wickBull : cg.wickBear)

        if show_candle_time
            timeStr = f_formatTime(time, selectedTz)
            candle.timeLabel := label.new(x = bar_index, y = candle.l, text = timeStr, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_up, color = color.new(color.black, 100), textcolor = cand_time_color, size = cand_time_size == 'tiny' ? size.tiny : cand_time_size == 'small' ? size.small : cand_time_size == 'normal' ? size.normal : cand_time_size == 'large' ? size.large : size.huge)

        if cg.showLiq
            lStyle = f_getLineStyle(cg.liqStyle)
            candle.high_line := line.new(bar_index, candle.h, bar_index + 1, candle.h, color = cg.liqColor, width = cg.liqWidth, style = lStyle)
            candle.low_line  := line.new(bar_index, candle.l, bar_index + 1, candle.l, color = cg.liqColor, width = cg.liqWidth, style = lStyle)

        array.unshift(cg.candles, candle)
        if array.size(cg.candles) > cg.max_candles
            old_candle = array.pop(cg.candles)
            box.delete(old_candle.body)
            line.delete(old_candle.wick_up)
            line.delete(old_candle.wick_down)
            label.delete(old_candle.timeLabel)
            if not na(old_candle.high_line)
                line.delete(old_candle.high_line)
            if not na(old_candle.low_line)
                line.delete(old_candle.low_line)

updateCurrentCandle(CandleGroup cg, int offset) =>
    if array.size(cg.candles) > 0
        candle = array.first(cg.candles)
        candle.h := math.max(high, candle.h)
        candle.l := math.min(low, candle.l)
        candle.c := close

        candlePrev = (array.size(cg.candles) > 1) ? array.get(cg.candles, 1) : na
        is_bull = candle.c > candle.o
        is_white = show_white_candle and not na(candlePrev) and ((candlePrev.h < candle.h and candlePrev.l > candle.c) or (candlePrev.l > candle.l and candlePrev.h < candle.c))

        c_body   = is_white ? white_candle_color : (is_bull ? cg.bodyBull : cg.bodyBear)
        c_border = is_white ? white_candle_color : (is_bull ? cg.borderBull : cg.borderBear)
        c_wick   = is_white ? white_candle_color : (is_bull ? cg.wickBull : cg.wickBear)

        box.set_top(candle.body, math.max(candle.o, candle.c))
        box.set_bottom(candle.body, math.min(candle.o, candle.c))
        box.set_bgcolor(candle.body, c_body)
        box.set_border_color(candle.body, c_border)
        line.set_y1(candle.wick_up, candle.h)
        line.set_y2(candle.wick_up, math.max(candle.o, candle.c))
        line.set_y1(candle.wick_down, candle.l)
        line.set_y2(candle.wick_down, math.min(candle.o, candle.c))
        line.set_color(candle.wick_up, c_wick)
        line.set_color(candle.wick_down, c_wick)

        if not na(candle.timeLabel)
            label.set_y(candle.timeLabel, candle.l)

        if barstate.islast
            reorderCandles(cg, offset)

// ============================================================================
// Liquidity Sweep Detection and Line Deletion Logic
// ============================================================================
checkLiquiditySweeps(CandleGroup cg) =>
    size = array.size(cg.candles)
    if cg.showLiq and size > 1
        for i = 1 to size - 1 by 1
            c = array.get(cg.candles, i)

            if not na(c.high_line) and high >= c.h
                line.delete(c.high_line)
                c.high_line := na

            if not na(c.low_line) and low <= c.l
                line.delete(c.low_line)
                c.low_line := na

// ============================================================================
// Main Execution Loop
// ============================================================================
if isOneMinChart
    bool isNewCandle15 = ta.change(time(group15.htf)) > 0
    bool isNewCandle4h = ta.change(time(group4h.htf)) > 0

    // 1. Update the 15-min group first to calculate the total width occupied by 15-min candles
    if show_htf_15 and isMarketOpen
        monitorNewCandle(group15, isNewCandle15)
        updateCurrentCandle(group15, chart_offset_15)
        checkLiquiditySweeps(group15)

    // 2. Dynamically calculate the 4H offset based on 15-min total width and spacing
    int size15 = array.size(group15.candles)
    int width_of_15m = size15 > 0 ? (size15 * candle_width) + ((size15 - 1) * candle_spacing) : 0
    int dynamic_offset_4h = chart_offset_15 + width_of_15m + chart_offset_4h

    // 4H updates only within the rolling window (UTC 05:00 to market close)
    if show_htf_4h and isFourHourWindow
        monitorNewCandle(group4h, isNewCandle4h)
        updateCurrentCandle(group4h, dynamic_offset_4h)
        checkLiquiditySweeps(group4h)
